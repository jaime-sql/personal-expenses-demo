{"datasets": [{"name": "ds_all", "displayName": "All movements", "queryLines": ["SELECT\n", "  charge_date_sv,\n", "  YEAR(charge_date_sv) AS charge_year,\n", "  MONTH(charge_date_sv) AS charge_month,\n", "  DAY(charge_date_sv) AS charge_day,\n", "  amount_usd,\n", "  CASE WHEN is_consumption THEN amount_usd ELSE CAST(0 AS DOUBLE) END AS consumption_amount,\n", "  CASE WHEN is_consumption THEN 1 ELSE 0 END AS consumption_row,\n", "  merchant,\n", "  merchant_norm,\n", "  bank,\n", "  card_last4,\n", "  category,\n", "  movement_type,\n", "  is_consumption\n", "FROM workspace.personal_expenses.silver_charges\n"]}, {"name": "ds_consumption", "displayName": "Consumption only", "queryLines": ["-- personal_expenses_source_email\n", "SELECT\n", "  base.*,\n", "  CASE WHEN src_bronze.message_id IS NOT NULL AND coalesce(base.message_id, src_silver.message_id) RLIKE '^[0-9a-fA-F]{15,20}$' AND src_bronze.thread_id RLIKE '^[0-9a-fA-F]{15,20}$' THEN concat('https://mail.google.com/mail/?authuser=viewer%40example.com#all/', src_bronze.thread_id) ELSE CAST(NULL AS STRING) END AS source_email_url\n", "FROM (\n", "SELECT charge_id, message_id,\n", "  charge_date_sv,\n", "  YEAR(charge_date_sv) AS charge_year,\n", "  MONTH(charge_date_sv) AS charge_month,\n", "  DAY(charge_date_sv) AS charge_day,\n", "  amount_usd,\n", "  merchant,\n", "  merchant_norm,\n", "  bank,\n", "  card_last4,\n", "  category,\n", "  movement_type,\n", "  is_consumption\n", "FROM workspace.personal_expenses.silver_charges\n", "WHERE is_consumption = true\n", ") base\n", "LEFT JOIN workspace.personal_expenses.silver_charges src_silver\n", "  ON base.charge_id = src_silver.charge_id\n", "LEFT JOIN (\n", "  SELECT message_id, max_by(thread_id, ingested_at) AS thread_id\n", "  FROM workspace.personal_expenses.bronze_mail_alerts\n", "  WHERE message_id IS NOT NULL AND message_id <> ''\n", "  GROUP BY message_id\n", ") src_bronze\n", "  ON coalesce(base.message_id, src_silver.message_id) = src_bronze.message_id\n"